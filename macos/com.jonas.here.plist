<?xml version="1.0" encoding="UTF-8"?>
<!-- UNTESTED (no Mac yet). macOS equivalent of home/.config/systemd/user/here.timer:
     runs ~/.local/bin/here-run every 20 min while awake. Installed by setup.sh. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jonas.here</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin" exec "$HOME/.local/bin/here-run"</string>
  </array>
  <key>StartInterval</key>
  <integer>1200</integer>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
